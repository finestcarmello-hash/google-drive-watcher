# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of chat IDs to send notifications to
# You can get chat IDs by messaging your bot and checking the logs
TELEGRAM_CHAT_IDS=123456789,987654321

# Performer Configuration
# Comma-separated list of Chaturbate usernames to monitor
PERFORMERS=username1,username2,username3

# Polling Configuration
# Poll interval in seconds (default: 30)
POLL_INTERVAL=30

# Jitter range in seconds to add randomness to polling (default: 5)
# This helps avoid all requests happening at exactly the same time
JITTER_RANGE=5

# Request Configuration
# Request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30

# User agent string for HTTP requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Log file path (default: logs/online_watcher.log)
LOG_FILE=logs/online_watcher.log

# Maximum log file size in bytes before rotation (default: 10485760 = 10MB)
LOG_MAX_BYTES=10485760

# Number of backup log files to keep (default: 5)
LOG_BACKUP_COUNT=5

# State Persistence
# File to store persistent state (default: .status.json)
STATE_FILE=.status.json