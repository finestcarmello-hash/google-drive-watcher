# Chaturbate Watch Bot Configuration
# Copy this file to .env and fill in your actual values

# Comma-separated list of performer usernames to monitor
USERNAMES=performer1,performer2,performer3

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of chat IDs to send notifications to
# You can get chat ID by messaging your bot and checking the logs
TELEGRAM_CHAT_IDS=123456789,987654321

# Polling interval in seconds (default: 30)
POLL_INTERVAL=30

# Optional: Custom user agent for requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36