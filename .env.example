# Telegram Bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Two comma-separated group chat IDs, e.g. -1001234567890,-1009876543210
TELEGRAM_CHAT_IDS=

# Comma-separated Google Drive folder IDs to watch (Shared Drive folders)
WATCH_FOLDER_IDS=

# Poll interval in seconds (e.g. 30)
POLL_INTERVAL_SECONDS=30

# Announce updates to Telegram (true/false). If false, still logs locally.
ANNOUNCE_UPDATES=true

# Path to Google OAuth credentials.json (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path to token.json (will be created after first OAuth)
GOOGLE_TOKEN_PATH=token.json

# SQLite DB path
SQLITE_DB_PATH=drive_watcher.db

# Optional: log directory (rotating files will be placed here)
LOG_DIR=logs
